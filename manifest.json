{
    "manifest_version": 2,
    "name": "Layout Lens",
    "version": "1.0",
    "description": "A tool that shows the current layout of the page",
    "icons": {
        "48": "lens-logo.svg",
        "96": "lens-logo.svg"
    },
    "permissions": ["activeTab", "devtools"],
    "devtools_page": "devtools/layoutlens.html",
    "browser_action": {
        "default_popup": "src/popup/popup.html",
        "default_icon": {
            "48": "lens-logo.svg",
            "96": "lens-logo.svg"
        }
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "layoutlens@example.com"
        }
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["./build/index.min.js"],
            "css": ["./build/index.min.css"]
        }
    ]
}